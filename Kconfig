	string "footer_fill: footer / icon strip"
	default ""

endmenu

choice
	prompt "Layout"
	default THEME_LAYOUT_VERTICAL

config THEME_LAYOUT_HORIZONTAL
	bool "horizontal (icons in a row above the items)"
config THEME_LAYOUT_VERTICAL
	bool "vertical (icon sidebar)"

endchoice

config THEME_LAYOUT
	string
	default "horizontal" if THEME_LAYOUT_HORIZONTAL
	default "vertical" if THEME_LAYOUT_VERTICAL

choice
	prompt "Frame"
	default THEME_FRAME_ROUNDED

config THEME_FRAME_FLAT
	bool "flat"
config THEME_FRAME_BEVEL
	bool "bevel"
config THEME_FRAME_OUTLINE
	bool "outline"
config THEME_FRAME_SHADOW
	bool "shadow"
config THEME_FRAME_DOUBLE
	bool "double"
config THEME_FRAME_ROUNDED
	bool "rounded"

endchoice

config THEME_FRAME
	string
	default "flat" if THEME_FRAME_FLAT
	default "bevel" if THEME_FRAME_BEVEL
	default "outline" if THEME_FRAME_OUTLINE
	default "shadow" if THEME_FRAME_SHADOW
	default "double" if THEME_FRAME_DOUBLE
	default "rounded" if THEME_FRAME_ROUNDED

choice
	prompt "Font"
	default THEME_FONT_DEJAVU_BOLD

config THEME_FONT_DEJAVU_BOLD
	bool "dejavu-bold"
config THEME_FONT_DEJAVU
	bool "dejavu"
config THEME_FONT_INTER
	bool "inter"
config THEME_FONT_MONO
	bool "mono (fixed 12-px cells)"

endchoice

config THEME_FONT
	string
	default "dejavu-bold" if THEME_FONT_DEJAVU_BOLD
	default "dejavu" if THEME_FONT_DEJAVU
	default "inter" if THEME_FONT_INTER
	default "mono" if THEME_FONT_MONO

endif

endmenu

menu "Languages"

comment "English is always built in: every other language falls back to it"

config LANG_DE
	bool "Deutsch"
	default y

config LANG_FR
	bool "Francais"
	default y

config LANG_ES
	bool "Espanol"
	default y

config LANG_IT
	bool "Italiano"
	default y

choice
	prompt "Default menu language"
	default LANG_DEFAULT_EN

config LANG_DEFAULT_EN
	bool "English"
config LANG_DEFAULT_DE
	bool "Deutsch"
	depends on LANG_DE
config LANG_DEFAULT_FR
	bool "Francais"
	depends on LANG_FR
config LANG_DEFAULT_ES
	bool "Espanol"
	depends on LANG_ES
config LANG_DEFAULT_IT
	bool "Italiano"
	depends on LANG_IT

endchoice

config LANG_DEFAULT
	string
	default "de" if LANG_DEFAULT_DE
	default "fr" if LANG_DEFAULT_FR
	default "es" if LANG_DEFAULT_ES
	default "it" if LANG_DEFAULT_IT
	default "en"

endmenu

menu "Features"

config FEATURE_PICTURE_MODES
	bool "Picture modes (Standard / Movie / Game / Text presets, MCCS DCh)"
	default y

config FEATURE_DCR
	bool "Dynamic contrast (backlight follows the picture, MCCS EAh)"
	default y

config FEATURE_LOW_BLUE
	bool "Low blue light filter (MCCS E6h)"
	default y

config FEATURE_USER_GAINS
	bool "User color temperature: R/G/B gains (MCCS 16h/18h/1Ah)"
	default y

endmenu

menu "Debug"

config DEBUG_VCP
	bool "DDC/CI debug codes (register peek/poke, flash test, bring-up hooks)"
	default y
	help
	  The manufacturer-range VCP codes the firmware is developed with,
	  none of them in the capabilities string: F0h/F1h register peek and
	  FCh poke, F2h/FBh/FDh indirect-port access, F3h/F4h scratch-sector
	  flash test, F5h/F6h settings-store state, F7h stack high-water mark
	  and reboot, F8h/F9h/FAh capture diagnostics and overrides, ECh-EFh
	  OSD SRAM / LUT pokes, FEh/FFh staged audio / DP bring-up, and the
	  log of the last Set VCPs.

config DEBUG_CONSOLE
	bool "Debug console (on-screen status page)"
	default y
	help
	  A third UI mode next to the boot logo and the input: live loop,
	  timebase, DDC/CI, display-clock, capture and link status over a red
	  background.  Reached from the menu (OSD > Debug console) or with
	  DDC/CI E7h = 2; any key returns to the picture.

endmenu

menu "Default settings"

comment "What a new board and a factory reset start from"

config DEFAULT_BOOT_LOGO
	bool "Show the boot logo"
	default y

config DEFAULT_MENU_2X
	bool "Menu size 2x"

config DEFAULT_SLIDER_POPUP
	bool "Edit values in a popup (else the slider replaces the item's value)"

endmenu
