mainmenu "OpenBezel firmware configuration"

# Edit with `ninja -C build menuconfig` (or guiconfig); start from a configs/*_defconfig
# (`meson setup build -Ddefconfig=...`).  Symbols reach the firmware as CONFIG_* in
# config.h (y = 1, n = undefined) and the build (meson.build) through .config.

menu "Board"

choice
	prompt "Board"
	default BOARD_INTOUCH156B

config BOARD_INTOUCH156B
	bool "inTouch 15.6\" (Realtek RTD2556: eDP 1920x1080, HDMI + USB-C)"
	select CHIP_RTD2556

endchoice

config BOARD
	string
	default "intouch156b" if BOARD_INTOUCH156B

config CHIP_RTD2556
	bool

config CHIP
	string
	default "rtd2556" if CHIP_RTD2556

comment "Gamma presets: out = in ^ (preset / native) per channel - panel native gamma x 100 - equal = neutral"

config PANEL_GAMMA_R
	int "Red"
	range 100 400
	default 213 if BOARD_INTOUCH156B
	default 220

config PANEL_GAMMA_G
	int "Green"
	range 100 400
	default 213 if BOARD_INTOUCH156B
	default 220

config PANEL_GAMMA_B
	int "Blue"
	range 100 400
	default 213 if BOARD_INTOUCH156B
	default 220

choice
	prompt "EDID"
	default EDID_OPENBEZEL
	help
	  What the monitor tells sources about itself (I2C 0x50 on HDMI,
	  I2C-over-AUX on DisplayPort).

config EDID_OPENBEZEL
	bool "OpenBezel (generated from boards/<board>/edid.json)"
	help
	  Built by tools/gen_edid.py from the board's description: the modes
	  the input can actually capture, RGB only, 2-channel audio.  Checked
	  with edid-decode --check when it is installed.

config EDID_STOCK
	bool "the board's stock EDID (boards/<board>/edid.bin)"
	help
	  The EDID the original firmware served.  It advertises modes and
	  color formats the OpenBezel input does not handle.

config EDID_CUSTOM
	bool "a custom EDID binary"

endchoice

config EDID_FILE
	string "EDID binary"
	depends on EDID_CUSTOM
	default ""
	help
	  Path to a 128- or 256-byte EDID.  Checksums are recomputed.

config EDID_NO_DEEP_COLOR
	bool "Clear the HDMI deep-color flags"
	depends on !EDID_OPENBEZEL
	default y
	help
	  The receiver has no deep-color (30/36/48-bit) path: with these flags
	  set a GPU may send 10 bpc and the picture breaks.

endmenu

menu "Menu themes"

comment "Every theme built in is selectable in the menu (OSD > Theme); each costs asset-partition space"

config THEME_MIDNIGHT
	bool "midnight - dark, vertical icon sidebar, rounded corners"
	default y

config THEME_CLASSIC
	bool "classic - horizontal icons, bevelled frame"
	default y

config THEME_MINIMAL
	bool "minimal - light, line icons, outlined"
	default y

config THEME_TERMINAL
	bool "terminal - green on black, monospace"
	default y

config THEME_CUSTOM
	bool "custom - pick every part below"
	help
	  A theme assembled from parts: icons, colors (optionally with any
	  color replaced), layout, frame and font.

choice
	prompt "Default theme"
	default THEME_DEFAULT_MIDNIGHT if THEME_MIDNIGHT
	default THEME_DEFAULT_CLASSIC if THEME_CLASSIC
	default THEME_DEFAULT_MINIMAL if THEME_MINIMAL
	default THEME_DEFAULT_TERMINAL if THEME_TERMINAL
	default THEME_DEFAULT_CUSTOM

config THEME_DEFAULT_MIDNIGHT
	bool "midnight"
	depends on THEME_MIDNIGHT
config THEME_DEFAULT_CLASSIC
	bool "classic"
	depends on THEME_CLASSIC
config THEME_DEFAULT_MINIMAL
	bool "minimal"
	depends on THEME_MINIMAL
config THEME_DEFAULT_TERMINAL
	bool "terminal"
	depends on THEME_TERMINAL
config THEME_DEFAULT_CUSTOM
	bool "custom"
	depends on THEME_CUSTOM

endchoice

config THEME_DEFAULT
	string
	default "midnight" if THEME_DEFAULT_MIDNIGHT
	default "classic" if THEME_DEFAULT_CLASSIC
	default "minimal" if THEME_DEFAULT_MINIMAL
	default "terminal" if THEME_DEFAULT_TERMINAL
	default "custom" if THEME_DEFAULT_CUSTOM

if THEME_CUSTOM

comment "The custom theme's parts"

choice
	prompt "Icons"
	default THEME_ICONS_FLAT

config THEME_ICONS_FLAT
	bool "flat (4-bit color)"
config THEME_ICONS_LINE
	bool "line (1-bit outline)"

endchoice

config THEME_ICONS
	string
	default "flat" if THEME_ICONS_FLAT
	default "line" if THEME_ICONS_LINE

choice
	prompt "Colors (base palette)"
	default THEME_COLORS_MIDNIGHT

config THEME_COLORS_MIDNIGHT
	bool "midnight"
config THEME_COLORS_CLASSIC
	bool "classic"
config THEME_COLORS_LIGHT
	bool "light"
config THEME_COLORS_TERMINAL
	bool "terminal"

endchoice

config THEME_COLORS
	string
	default "midnight" if THEME_COLORS_MIDNIGHT
	default "classic" if THEME_COLORS_CLASSIC
	default "light" if THEME_COLORS_LIGHT
	default "terminal" if THEME_COLORS_TERMINAL

menu "Custom colors (#RRGGBB; empty = the base palette's)"

config THEME_COLOR_PANEL
